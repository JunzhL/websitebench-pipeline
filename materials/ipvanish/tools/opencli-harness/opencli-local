#!/bin/sh
# Transparent local stand-in for the OpenCLI binary.
#
# The real OpenCLI CLI is not installed on this host and installing adapters
# into ~/.opencli is out of bounds for this run. This wrapper runs the harness
# that executes the COMMITTED, generator-produced wb-ipvanish adapters verbatim.
# It identifies itself as `wb-local-adapter-harness`, never as OpenCLI.
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec node "$HERE/runner.mjs" "$@"
