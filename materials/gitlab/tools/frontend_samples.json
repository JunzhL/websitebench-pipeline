{
  "schema_version": "gitlab.frontend-gate-samples.v1",
  "app_file": "clone/app.py",
  "app_attr": "app",
  "module_name": "gitlab_clone_app",
  "checks": [
    {
      "id": "recovery-and-errors.explore",
      "url": "/explore/projects",
      "method": "get",
      "expect_status": 200,
      "expect_contains": ["gitlab-org / gitlab-runner"],
      "expect_not_contains": ["NotImplementedError"],
      "session": false
    },
    {
      "id": "recovery-and-errors.project",
      "url": "/gitlab-org/gitlab-runner",
      "method": "get",
      "expect_status": 200,
      "expect_contains": ["Project information"],
      "expect_not_contains": ["NotImplementedError"],
      "session": false
    },
    {
      "id": "recovery-and-errors.repository",
      "url": "/gitlab-org/gitlab-runner/-/tree/main",
      "method": "get",
      "expect_status": 200,
      "expect_contains": ["Files"],
      "expect_not_contains": ["NotImplementedError"],
      "session": false
    },
    {
      "id": "recovery-and-errors.commits",
