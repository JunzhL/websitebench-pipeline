    {
      "id": "recovery-and-errors.no-results",
      "url": "/explore/projects?name=zzzz-no-match-websitebench",
      "method": "get",
      "expect_status": 200,
      "expect_contains": ["View all projects"],
      "expect_not_contains": ["NotImplementedError"],
      "session": false
    },
    {
      "id": "recovery-and-errors.sign-in",
