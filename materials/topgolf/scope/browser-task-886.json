{
  "schema_version":"websitebench.offline-clone.browser-scenario.v1",
  "scenario_id":"topgolf-task-886-review",
  "viewport":{"width":1440,"height":900},
  "timeout_ms":10000,
  "source_mutations_authorized":false,
  "allowed_origins":{"source":["https://topgolf.com","https://book.topgolf.com"],"clone":["http://127.0.0.1:8768"]},
  "steps":[
    {"id":"home","action":"goto","path":"/us/","observations":[{"id":"home-heading","kind":"text","selector":{"clone":"h1","source":"h1"},"expect":{"contains":"It's golf"}}]},
    {"id":"play-navigation","action":"click","selector":{"clone":"nav.nav a[href='/us/experience/']","source":"a[href='/us/experience/']"}},
    {"id":"experience-destination","action":"snapshot","observations":[{"id":"experience-path","kind":"url_path","expect":{"equals":"/us/experience/"}},{"id":"experience-heading","kind":"text","selector":{"clone":"h1","source":"h1"},"expect":{"contains":"Topgolf Experience"}},{"id":"canonical-path","kind":"text","selector":{"clone":".canonical","source":"main"},"expect":{"contains":"/us/experience/"}}],"screenshot":true,"full_page":true},
    {"id":"locations","action":"goto","path":"/us/locations/"},
    {"id":"toronto-query","action":"fill","selector":{"clone":"input[name=q]","source":"input"},"value":"Toronto"},
    {"id":"search-toronto","action":"click","selector":{"clone":"[data-location-search] button[type=submit]","source":"button"}},
    {"id":"wait-locations","action":"wait","selector":{"clone":"[data-location-results] .cards","source":"main"}},
    {"id":"nearest-proof","action":"snapshot","observations":[{"id":"cleveland-nearest","kind":"text","selector":{"clone":"[data-location-results] article:first-child","source":"main"},"expect":{"matches":"311\\.3 km.*Topgolf Cleveland.*Closest observed Topgolf"}},{"id":"avon-second","kind":"text","selector":{"clone":"[data-location-results] article:nth-child(2)","source":"main"},"expect":{"matches":"324\\.5 km.*Topgolf Avon"}}],"screenshot":true,"full_page":true},
    {"id":"open-cleveland","action":"click","selector":{"clone":"[data-location-results] article:first-child a","source":"main a"}},
    {"id":"venue-detail","action":"snapshot","observations":[{"id":"venue-heading","kind":"text","selector":{"clone":"h1","source":"h1"},"expect":{"contains":"Topgolf Cleveland"}},{"id":"pricing","kind":"text","selector":{"clone":"main","source":"main"},"expect":{"contains":"$44 per hour per bay"}},{"id":"policy","kind":"text","selector":{"clone":"main","source":"main"},"expect":{"contains":"Up to six players"}},{"id":"book-action","kind":"visible","selector":{"clone":"main a[href='/us/cleveland/plan-a-visit/']","source":"main a"},"expect":{"equals":true}}]},
    {"id":"open-plan-visit","action":"click","selector":{"clone":"aside a[href='/us/cleveland/plan-a-visit/']","source":"main a"}},
    {"id":"wait-slots","action":"wait","selector":{"clone":"[data-slots] [data-slot]:first-child","source":"main"}},
    {"id":"task-options","action":"snapshot","observations":[{"id":"date","kind":"text","selector":{"clone":"select[name=date] option:checked","source":"main"},"expect":{"contains":"Saturday, September 5, 2026"}},{"id":"time","kind":"text","selector":{"clone":"select[name=time] option:checked","source":"main"},"expect":{"contains":"2:00 PM"}},{"id":"players","kind":"text","selector":{"clone":"select[name=players] option:checked","source":"main"},"expect":{"contains":"4 players"}},{"id":"longest","kind":"text","selector":{"clone":"[data-slot='cle-20260905-1400-120']","source":"main"},"expect":{"matches":"120 minutes.*2:00 PM - 4:00 PM.*RECOMMENDED.*\\$88\\.00"}},{"id":"ninety","kind":"text","selector":{"clone":"[data-slot='cle-20260905-1400-90']","source":"main"},"expect":{"matches":"90 minutes.*\\$66\\.00"}},{"id":"unavailable","kind":"text","selector":{"clone":"[data-slot='cle-20260905-1400-60']","source":"main"},"expect":{"matches":"60 minutes.*Unavailable"}}],"screenshot":true,"full_page":true},
    {"id":"compare-90","action":"click","selector":{"clone":"[data-slot='cle-20260905-1400-90']","source":"main button"}},
    {"id":"ninety-selection","action":"snapshot","observations":[{"id":"ninety-total","kind":"text","selector":{"clone":"[data-selection]","source":"main"},"expect":{"matches":"90 minutes.*\\$66\\.00"}}]},
    {"id":"select-longest","action":"click","selector":{"clone":"[data-slot='cle-20260905-1400-120']","source":"main button"}},
    {"id":"continue-review","action":"click","selector":{"clone":"[data-selection] [data-continue]","source":"main button"}},
    {"id":"wait-review","action":"wait","selector":{"clone":"[data-booking-form]","source":"main"}},
    {"id":"review-selection","action":"snapshot","observations":[{"id":"review-heading","kind":"text","selector":{"clone":"h1","source":"h1"},"expect":{"contains":"Review your bay"}},{"id":"review-choices","kind":"text","selector":{"clone":"aside.panel","source":"main"},"expect":{"matches":"Topgolf Cleveland.*Saturday, September 5, 2026.*2:00 PM - 4:00 PM.*120 minutes.*Players.*4.*Bays.*1"}},{"id":"subtotal","kind":"text","selector":{"clone":"aside.panel","source":"main"},"expect":{"contains":"Gameplay subtotal $88.00"}},{"id":"total","kind":"text","selector":{"clone":"aside.panel","source":"main"},"expect":{"contains":"Total $88.00 USD"}},{"id":"tax-gap","kind":"text","selector":{"clone":"aside.panel","source":"main"},"expect":{"contains":"Tax Unavailable, not included"}},{"id":"sandbox","kind":"text","selector":{"clone":"main","source":"main"},"expect":{"contains":"Offline sandbox"}}],"screenshot":true,"full_page":true},
    {"id":"empty-submit","action":"click","selector":{"clone":"[data-booking-form] button[type=submit]","source":"button[type=submit]"}},
    {"id":"required-validation","action":"snapshot","observations":[{"id":"required-errors","kind":"text","selector":{"clone":"[data-form-error]","source":"main"},"expect":{"matches":"first name is required.*last name is required.*phone is required.*email is required.*Accept the Terms"}}]},
    {"id":"first-name","action":"fill","selector":{"clone":"input[name=first_name]","source":"input"},"value":"Task"},
    {"id":"last-name","action":"fill","selector":{"clone":"input[name=last_name]","source":"input"},"value":"Player"},
    {"id":"phone","action":"fill","selector":{"clone":"input[name=phone]","source":"input"},"value":"416-555-0188"},
    {"id":"email","action":"fill","selector":{"clone":"input[name=email]","source":"input"},"value":"task886@example.test"},
    {"id":"terms","action":"check","selector":{"clone":"input[name=terms_accepted]","source":"input[type=checkbox]"}},
    {"id":"decline","action":"select","selector":{"clone":"select[name=scenario_id]","source":"select"},"option":"sandbox-declined"},
    {"id":"submit-decline","action":"click","selector":{"clone":"[data-booking-form] button[type=submit]","source":"button"}},
    {"id":"wait-decline","action":"wait","milliseconds":150},
    {"id":"declined-state","action":"snapshot","observations":[{"id":"declined-message","kind":"text","selector":{"clone":"[data-form-error]","source":"main"},"expect":{"contains":"Sandbox payment was declined"}},{"id":"review-retained","kind":"url_path","expect":{"equals":"/booking/review"}}]},
    {"id":"retry","action":"select","selector":{"clone":"select[name=scenario_id]","source":"select"},"option":"sandbox-retry"},
    {"id":"submit-retry","action":"click","selector":{"clone":"[data-booking-form] button[type=submit]","source":"button"}},
    {"id":"wait-retry","action":"wait","milliseconds":150},
    {"id":"retry-state","action":"snapshot","observations":[{"id":"retry-message","kind":"text","selector":{"clone":"[data-form-error]","source":"main"},"expect":{"contains":"Sandbox payment needs a retry"}}]},
    {"id":"approve","action":"select","selector":{"clone":"select[name=scenario_id]","source":"select"},"option":"sandbox-approved"},
    {"id":"submit-approval","action":"click","selector":{"clone":"[data-booking-form] button[type=submit]","source":"button"}},
    {"id":"wait-confirmation","action":"wait","selector":{"clone":".confirmation","source":"main"}},
    {"id":"confirmation","action":"snapshot","observations":[{"id":"confirmation-heading","kind":"text","selector":{"clone":"h1","source":"h1"},"expect":{"contains":"Your bay is booked"}},{"id":"confirmation-choices","kind":"text","selector":{"clone":".confirmation","source":"main"},"expect":{"matches":"Topgolf Cleveland.*Saturday, September 5, 2026.*2:00 PM - 4:00 PM.*120 minutes.*Players.*4.*Bays.*1"}},{"id":"confirmation-subtotal","kind":"text","selector":{"clone":".confirmation","source":"main"},"expect":{"contains":"Gameplay subtotal $88.00"}},{"id":"confirmation-total","kind":"text","selector":{"clone":".confirmation","source":"main"},"expect":{"contains":"Total $88.00 USD"}},{"id":"local-payment","kind":"text","selector":{"clone":".confirmation","source":"main"},"expect":{"contains":"Approved, local-sandbox"}}],"screenshot":true,"full_page":true},
    {"id":"refresh","action":"press","selector":{"clone":"body","source":"body"},"key":"Meta+R"},
    {"id":"wait-refresh","action":"wait","selector":{"clone":".confirmation","source":"main"}},
    {"id":"persisted-confirmation","action":"snapshot","observations":[{"id":"persisted-heading","kind":"text","selector":{"clone":"h1","source":"h1"},"expect":{"contains":"Your bay is booked"}},{"id":"persisted-total","kind":"text","selector":{"clone":".confirmation","source":"main"},"expect":{"contains":"$88.00 USD"}}]},
    {"id":"no-results","action":"goto","path":"/us/locations/"},
    {"id":"no-results-query","action":"fill","selector":{"clone":"input[name=q]","source":"input"},"value":"zzzz-no-match-websitebench"},
    {"id":"no-results-submit","action":"click","selector":{"clone":"[data-location-search] button","source":"button"}},
    {"id":"wait-empty","action":"wait","selector":{"clone":".empty","source":"main"}},
    {"id":"no-results-recovery","action":"snapshot","observations":[{"id":"no-results-message","kind":"text","selector":{"clone":".empty","source":"main"},"expect":{"contains":"No locations found"}},{"id":"return-control","kind":"text","selector":{"clone":".empty button","source":"main"},"expect":{"contains":"VIEW AVAILABLE LOCATIONS"}}]},
    {"id":"help","action":"goto","path":"/us/company/contact-us/"},
    {"id":"help-guidance","action":"snapshot","observations":[{"id":"booking-help","kind":"text","selector":{"clone":"main","source":"main"},"expect":{"contains":"Reservations"}},{"id":"account-help","kind":"text","selector":{"clone":"main","source":"main"},"expect":{"contains":"Account access"}},{"id":"failure-help","kind":"text","selector":{"clone":"main","source":"main"},"expect":{"contains":"Failed action"}},{"id":"no-message","kind":"text","selector":{"clone":"main","source":"main"},"expect":{"contains":"never sends messages"}}]},
    {"id":"not-found","action":"goto","path":"/zzzz-no-such-topgolf-page"},
    {"id":"branded-404","action":"snapshot","observations":[{"id":"not-found-heading","kind":"text","selector":{"clone":"h1","source":"h1"},"expect":{"contains":"out of bounds"}},{"id":"nav-preserved","kind":"visible","selector":{"clone":"nav.nav a[href='/us/experience/']","source":"nav a"},"expect":{"equals":true}},{"id":"safe-return","kind":"visible","selector":{"clone":"main a[href='/us/locations/']","source":"main a"},"expect":{"equals":true}}],"screenshot":true,"full_page":true}
  ]
}
