{
  "database": {
    "data_dir": "data",
    "engine": "sqlite",
    "filename": "topgolf.sqlite3",
    "legacy_unbound_migration": false,
    "migration_hook": "backend.domain:migrate",
    "seed_hook": "backend.domain:seed"
  },
  "deployment": {
    "profiles": {
      "cloudflare-review": {
        "mail_adapter": "redis-resend",
        "payment_adapter": "local-sandbox",
        "persistence": "ephemeral-reset"
      },
      "docker-volume": {
        "mail_adapter": "effects-gateway",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent-volume"
      },
      "offline-harbor": {
        "mail_adapter": "local-outbox",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent"
      }
    }
  },
  "mail": {
    "enabled": false,
    "purposes": {},
    "sender": {
      "address_env": "RESEND_FROM_EMAIL",
      "display_name": "Topgolf"
    }
  },
  "payments": {
    "currency": "USD",
    "default_adapter": "local-sandbox",
    "local_sandbox": {
      "scenarios": [
        {
          "display_label": "Simulated approval",
          "id": "sandbox-approved",
          "outcome": "approved"
        },
        {
          "display_label": "Simulated decline",
          "id": "sandbox-declined",
          "outcome": "declined"
        },
        {
          "display_label": "Simulated retry",
          "id": "sandbox-retry",
          "outcome": "retryable"
        }
      ]
    },
    "stripe_test": null
  },
  "schema_version": "websitebench.site-backend-runtime.v1",
  "session": {
    "host_only": true,
    "http_only": true,
    "same_site": "Lax",
    "secure": true
  },
  "site": {
    "id": "topgolf",
    "label": "Topgolf",
    "public_origin": "https://topgolf.offline.invalid"
  }
}
