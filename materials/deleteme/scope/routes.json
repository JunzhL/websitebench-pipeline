      ]
    },
    {
      "id": "policies",
      "local_destination": true,
      "note": "Single-origin mapping of privacy.joindeleteme.com/policies, reached from the checkout agreements via ?name=terms-of-service and ?name=privacy-policy.",
      "priority": "p2",
      "purpose_edge": "secondary",
      "route_pattern": "/policies",
      "states": [
        "loaded"
      ]
    },
    {
      "id": "account-dashboard",
      "local_destination": true,
      "note": "Clone-local only. The subscriber dashboard, removal profile, reports, billing history, plan change, pause/skip, cancel and reactivate were never observable: DeleteMe issues an account only after a purchase this run may not make. Every such page carries a clone-local banner.",
      "priority": "p1",
      "purpose_edge": "secondary",
      "route_pattern": "/account",
      "states": [
        "unavailable"
      ]
    },
    {
      "id": "not-found",
      "local_destination": true,
      "note": "Marketing host: an extensionless unknown path 301s to the trailing-slash form and then answers HTTP 404 with full chrome, headings 'Oops!' and \u201cThat page can\u2019t be found.\u201d, body 'It looks like nothing was found at this location.', and Back plus 'Go to the homepage'.",
      "priority": "p1",
      "purpose_edge": "secondary",
      "route_pattern": "/*",
      "states": [
        "not-found"
      ]
    },
    {
      "id": "app-not-found",
      "local_destination": true,
      "note": "The application host answers unknown routes with HTTP 200 (SPA shell) and H1 'Page not found'. The two hosts disagree on status; the clone reproduces both behaviours on their mapped paths rather than normalising them.",
      "priority": "p2",
      "purpose_edge": "secondary",
      "route_pattern": "/account/*",
      "states": [
        "not-found"
      ]
    }
  ],
  "schema_version": "offline-clone.routes.v1"
}
