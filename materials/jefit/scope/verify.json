  "session": {
    "accounts": {
      "isolation": {
        "form": {
          "password": "Iso-Pass-2026!",
          "username": "isotest"
        },
        "routes": []
      },
      "primary": {
        "form": {
          "password": "Demo-Pass-2026!",
          "username": "jefitdemo"
        },
        "routes": [
          "my-jefit",
          "my-jefit-qa",
          "my-jefit-popular",
          "my-jefit-progress",
