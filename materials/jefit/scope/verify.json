{
  "boot": {
    "argv": [
      "{python}",
      "-m",
      "uvicorn",
      "app:app",
      "--host",
      "127.0.0.1",
      "--port",
      "{port}",
      "--log-level",
      "warning"
    ],
    "cwd": "clone",
    "env": {
      "DATA_DIR": "{data_dir}"
    }
  },
  "deferred": {},
  "note": "Driver data for the generic diagnostics. Session credentials below are the clone's deterministic synthetic seed fixtures, not real credentials. The two source-unavailable post-payment states (elite-checkout.success, my-jefit-settings.elite-active) are implemented clone-locally and reached through the sandbox-approved checkout recipe.",
