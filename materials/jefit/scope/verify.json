  "site_id": "jefit",
  "states": {
    "build-routine.validation-error": [
      {
        "click": "button:text-is('X')",
        "optional": true
      },
      {
        "click": "button:text-is('Save')"
      },
      {
        "expect": "text=This day is empty"
      }
    ],
    "elite-checkout.declined": [
      {
        "click": "input[value='sandbox-declined']"
      },
      {
        "click": "form[action='/elite/checkout'] button[type='submit']"
      },
      {
        "expect": "[data-checkout-error]"
      }
    ],
    "elite-checkout.monthly": [
      {
        "goto": "/elite/checkout?isMyJefit=true&sub=monthly"
      }
    ],
    "elite-checkout.retry": [
      {
        "click": "input[value='sandbox-retry']"
      },
      {
        "click": "form[action='/elite/checkout'] button[type='submit']"
      },
      {
        "expect": "[data-checkout-error]"
      }
